{
  "name": "url-guard",
  "version": "1.0.0",
  "private": true,
  "description": "Browser extension that flags phishing, fraud, and gambling lookalike sites by URL",
  "type": "module",
  "scripts": {
    "test": "npx c8 node --test tests/**/*.test.js",
    "test:coverage": "npx c8 --reporter=text --reporter=html node --test tests/**/*.test.js",
    "icons": "node scripts/generate-icons.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "c8": "^10.1.3"
  }
}
